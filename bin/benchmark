#!/usr/bin/env python3
"""Measures parch in its real window, and compares the results with a baseline.

    bin/benchmark OUTDIR                    the standard matrix, three runs each
    bin/benchmark OUTDIR --view split       one view of the three plain documents
    bin/benchmark --summary OUTDIR          the summary of runs already in OUTDIR
    ... --compare BASELINE                  and the gate figures against a baseline

Every run measures a copy of a generated document of its own (a typical
10,000-word document, a 100,000-word book, one 10,000-word paragraph, and a
rich document with pictures, a large table, formulas, diagrams, included
chapters and a bibliography) with `parch open --benchmark`, which writes
OUTDIR/<case>-<run>.json. The summary, OUTDIR/summary.json and
OUTDIR/summary.md, holds the median of each figure over the runs of a case,
set against the performance gates. A comparison flags every gate figure that
is more than 20 % worse than the baseline's (a summary.json, such as
tests/benchmark-baseline.json), and then exits with 3.

Run it in the desktop session with the screen awake and nothing else busy,
and leave its windows in front until it ends; a run takes about a minute and
a half. With --offscreen it runs without a display, on Qt's software
renderer, which is no measure of the desktop: use it to check the harness
and to compare one change with another on the same machine.
"""
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import statistics
import struct
import subprocess
import sys
import tempfile
import time
import zlib

ROOT = Path(__file__).resolve().parent.parent
PROSE = "the quiet writer keeps each ordinary word and reads again".split()
WORD = re.compile(r"[A-Za-z0-9]+(?:'[A-Za-z0-9]+)*")
DOCUMENTS = ("typical", "book", "long-paragraph", "rich")

# The standard matrix: (document, view, windows, adversarial). The typical
# document comes last, so that its launch, which has a gate, finds the
# system's caches warm.
MATRIX = (
    ("long-paragraph", "source", 1, False),
    ("long-paragraph", "split", 1, False),
    ("book", "source", 1, False),
    ("book", "split", 1, False),
    ("rich", "split", 1, False),
    ("typical", "split", 1, True),
    ("typical", "split", 2, False),
    ("typical", "split", 1, False),
    ("typical", "source", 1, False),
)

# The figures compared with a baseline, the gates' own, each with the
# least change that counts beside the 20 %: what a timer or a count can
# differ by between two runs of the same build.
COMPARED = {
    "launchMs": 5.0,
    "keyToFrameP95": 0.5,
    "typingUiP95": 0.5,
    "scrollP95": 0.5,
    "rewrapP95": 0.5,
    "rewrapSettleMs": 5.0,
    "layoutsWhileMoving": 1,
    "idleFramesBesidesCaret": 1,
    "idleCpuTicks": 1,
    "pssMiB": 2.0,
}


def plain(kind):
    """The plain documents: a seed, then the ten prose words over and over,
    a paragraph break every 80 words (every 1,000 in the book) and none in
    the long paragraph. The seeds are ASCII."""
    count = 100000 if kind == "book" else 10000
    if kind == "typical":
        seed = ("# A quiet morning\n\nThe writer keeps ordinary Markdown source.\n\n"
                "## Notes\n\n- Keep a list\n- Follow [a link](https://example.org/notes)\n\n"
                "```cpp\nint value = 1;\n```\n\n"
                "```text\nA second literal example.\n```\n\n")
    elif kind == "book":
        seed = ("# The generated book\n\nA chapter with [references][reading] and a footnote[^note].\n\n"
                "[reading]: https://example.org/book\n[^note]: A deterministic note.\n\n")
    else:
        seed = ""
    used = len(WORD.findall(seed))
    if used > count:
        seed, used = "", 0
    every = 1000 if kind == "book" else 80
    parts = [seed]
    for i in range(used, count):
        if i > used:
            parts.append("\n\n" if kind != "long-paragraph" and (i - used) % every == 0 else " ")
        parts.append(PROSE[(i - used) % 10])
    return "".join(parts)


def prose(words, start=0, every=80):
    parts = []
    for i in range(words):
        if i:
            parts.append("\n\n" if i % every == 0 else " ")
        parts.append(PROSE[(start + i) % 10])
    return "".join(parts)


def png(path, width, height, shade):
    """A picture in PNG, made here: a gradient of its own shade."""
    rows = bytearray()
    for y in range(height):
        rows.append(0)
        for x in range(width):
            rows += bytes(((x * 255 // width + 40 * shade) % 256, (y * 255 // height) % 256, (60 * shade) % 256))

    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)

    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
                     + chunk(b"IDAT", zlib.compress(bytes(rows), 6)) + chunk(b"IEND", b""))


def rich(folder):
    """The rich document, in a folder of its own: about 10,000 words of its
    own and 2,000 in two included chapters, six local pictures, a table of
    200 rows, 50 formulas, 10 diagrams and 40 citations of a 20-work
    bibliography, formatted in the APA style."""
    for n in range(1, 7):
        png(folder / "images" / f"figure-{n}.png", 480, 300, n)
    (folder / "references.bib").write_text("\n".join(
        f"@book{{work{n},\n  author = {{Writer, Ada and Reader, Ben}},\n  title = {{A Quiet Book, Part {n}}},\n"
        f"  publisher = {{Plain Press}},\n  address = {{Lisbon}},\n  year = {{{1990 + n}}}\n}}\n" for n in range(1, 21)))
    for n, name in ((1, "one"), (2, "two")):
        (folder / f"chapter-{name}.md").write_text(
            f"## An included chapter {name}\n\n{prose(1000, 3 * n)}\n\n"
            f"The chapter's own formula $a_{n} = b^{{{n}}}$ and a citation [@work{n + 10}].\n")
    sections = []
    for s in range(1, 11):
        parts = [f"## Section {s}", prose(760, s)]
        parts.append(" ".join(f"A formula $x_{{{s}{k}}}^2 + y_{k} = \\frac{{{s}}}{{{k + 1}}}$ in the text."
                              for k in range(4)))
        parts.append(f"$$\n\\sum_{{i=1}}^{{{s + 9}}} i^2 = \\frac{{n(n+1)(2n+1)}}{{6}} + {s}\n$$")
        parts.append(f"```mermaid\nflowchart LR\n  A{s}[Draft {s}] --> B{s}{{Review}}\n"
                     f"  B{s} -->|keep| C{s}[Section {s}]\n  B{s} -->|again| A{s}\n```")
        parts.append(f"As one study shows [@work{s}], and another [@work{s + 1}, p. {10 + s}], "
                     f"the writer reads again [see @work{(s + 4) % 20 + 1}; @work{(s + 8) % 20 + 1}].")
        if s <= 6:
            parts.append(f"![Figure {s}, a gradient of its own](images/figure-{s}.png)")
        if s == 5:
            header = "| Row | Writer | Words | Pages | Draft | Note |\n| ---: | --- | ---: | ---: | :---: | --- |"
            rows = "\n".join(f"| {r} | {PROSE[r % 10]} {PROSE[(r + 3) % 10]} | {r * 37 % 1000} | {r % 300} | "
                             f"{'yes' if r % 3 else 'no'} | {PROSE[(r + 5) % 10]} |" for r in range(1, 201))
            parts.append(header + "\n" + rows)
        if s == 3:
            parts.append("chapter-one.md")
        if s == 7:
            parts.append("chapter-two.md")
        sections.append("\n\n".join(parts))
    text = ("---\ntitle: A rich document\nbibliography: references.bib\ncsl: apa\n---\n\n# A rich document\n\n"
            + "\n\n".join(sections) + "\n\n## References\n")
    (folder / "rich.md").write_text(text)
    return folder / "rich.md"


def generate(work):
    """Each document in a folder of its own, which every run copies."""
    made = {}
    for kind in DOCUMENTS:
        folder = work / "documents" / kind
        folder.mkdir(parents=True)
        if kind == "rich":
            made[kind] = rich(folder)
        else:
            made[kind] = folder / f"{kind}.md"
            made[kind].write_text(plain(kind))
    return made


def case_name(document, view, windows, adversarial):
    return f"{document}-{view}" + ("-2windows" if windows > 1 else "") + ("-adversarial" if adversarial else "")


def load():
    return [round(value, 2) for value in os.getloadavg()]


def run_matrix(out, cases, runs, offscreen):
    subprocess.run([str(ROOT / "bin" / "build")], check=True, stdout=sys.stderr)
    env = dict(os.environ)
    if offscreen:
        env.update(QT_QPA_PLATFORM="offscreen", QT_QUICK_BACKEND="software")
        env.pop("HYPRLAND_INSTANCE_SIGNATURE", None)
    started = {"time": time.strftime("%Y-%m-%d %H:%M:%S"), "load": load()}
    failures = {}
    with tempfile.TemporaryDirectory(prefix="parch-benchmark.") as temporary:
        work = Path(temporary)
        documents = generate(work)
        for document, view, windows, adversarial in cases:
            name = case_name(document, view, windows, adversarial)
            for run in range(1, runs + 1):
                # Every run measures a copy of its own, beside what it reads.
                folder = work / f"{name}-{run}"
                shutil.copytree(documents[document].parent, folder)
                result = out / f"{name}-{run}.json"
                command = [str(ROOT / "build" / "parch"), "open", "--benchmark", str(result), "--force", "--view", view,
                           "--windows", str(windows)]
                if adversarial:
                    command.append("--adversarial")
                command.append(str(folder / documents[document].name))
                done = subprocess.run(command, env=env)
                shutil.rmtree(folder, ignore_errors=True)
                if done.returncode != 0:
                    failures[f"{name}-{run}"] = done.returncode
                    print(f"{name}-{run}: failed with {done.returncode}", file=sys.stderr)
                else:
                    print(result, flush=True)
    return {"started": started, "ended": {"time": time.strftime("%Y-%m-%d %H:%M:%S"), "load": load()},
            "offscreen": offscreen, "failures": failures,
            "matrix": [list(case) for case in cases]}


def worst(places, key, stat):
    values = [place[key][stat] for place in places if stat in place.get(key, {})]
    return max(values) if values else None


def figures(result):
    """One run's figures, as the gates read them."""
    places = list(result.get("typing", {}).values())
    control = result.get("control", {})
    rewrap = result.get("rewrapSettle", {})
    dropped = result.get("droppedFrames", {})
    edits = result.get("adversarialEdits", {})
    found = {
        "launchMs": result.get("launchToEditableMs"),
        "keyToFrameP95": worst(places, "keyToFrameMs", "p95"),
        "typingUiP95": worst(places, "dispatchMs", "p95"),
        "typingCpuMsPerKey": result.get("typingCpuMsPerKey"),
        "typingUiThreadCpuMsPerKey": result.get("typingUiThreadCpuMsPerKey"),
        "typingOtherThreadsCpuMsPerKey": result.get("typingOtherThreadsCpuMsPerKey"),
        "typingParsesPerKey": result.get("typingParsesPerKey"),
        "scrollP95": result.get("scrollFrameMs", {}).get("p95"),
        "controlScrollP95": control.get("scrollFrameMs", {}).get("p95"),
        "rewrapP95": result.get("rewrapFrameMs", {}).get("p95"),
        "controlRewrapP95": control.get("rewrapFrameMs", {}).get("p95"),
        "rewrapSettleMs": rewrap.get("settleMs"),
        "layoutsWhileMoving": rewrap.get("layoutsWhileMoving"),
        "refreshIntervalMs": dropped.get("refreshIntervalMs"),
        "droppedFramesScrolling": dropped.get("scroll"),
        "droppedFramesTyping": dropped.get("typing"),
        "idleFramesBesidesCaret": result.get("idleFramesBesidesCaret"),
        "idleCpuTicks": result.get("idleCpuTicksWithHelpers", result.get("idleCpuTicks")),
        "idleWakeups": result.get("idleWakeups"),
        "idleContextSwitches": result.get("idleContextSwitches"),
        "pssMiB": result.get("pssEndWithOwnedMiB"),
        "recoveryRestoreMs": result.get("recoveryRestore", {}).get("toFrameMs"),
        "secondWindowMs": result.get("secondWindow", {}).get("loadMs"),
    }
    for edit in ("paste", "undo", "nesting", "rapid"):
        if edit in edits:
            found[f"{edit}CaughtUpMs"] = edits[edit].get("caughtUpMs")
    if "rapid" in edits:
        found["rapidKeyToFrameP95"] = edits["rapid"].get("keyToFrameMs", {}).get("p95")
    return {key: value for key, value in found.items() if value is not None}


def summarize(out, ran=None):
    """The median of every figure over the runs of each case."""
    cases = {}
    machine = {}
    for path in sorted(out.glob("*.json")):
        if path.name == "summary.json":
            continue
        match = re.fullmatch(r"(.+)-(\d+)\.json", path.name)
        if not match:
            continue
        result = json.loads(path.read_text())
        name = match.group(1)
        # The label is the document's name without its suffix: its kind.
        case = cases.setdefault(name, {"document": result.get("label", name),
                                       "view": result.get("view", "source"), "windows": result.get("windows", 1),
                                       "adversarial": result.get("adversarial", False), "runs": []})
        case["runs"].append(figures(result))
        for key in ("qt", "platform", "graphicsApi", "refreshHz", "devicePixelRatio"):
            machine.setdefault(key, result.get(key))
        machine.setdefault("spellingActive", result.get("spellingActive"))
    summary = {"machine": {**machine, "architecture": os.uname().machine, "cpus": os.cpu_count()}, "cases": {}}
    if ran:
        summary["runs"] = ran
    for name, case in cases.items():
        keys = sorted({key for run in case["runs"] for key in run})
        medians = {key: statistics.median([run[key] for run in case["runs"] if key in run]) for key in keys}
        summary["cases"][name] = {"document": case["document"], "view": case["view"], "windows": case["windows"],
                                  "adversarial": case["adversarial"], "runs": len(case["runs"]), "figures": medians}
    return summary


def gates(case):
    """The gates of the editor decision that apply to a case: name, target,
    measured value and whether it passes."""
    document = case["document"]
    f = case["figures"]
    frame = f.get("refreshIntervalMs", 1000 / 60)
    found = []

    def add(name, target, value, passes):
        found.append((name, target, value, passes))

    if document == "typical" and "launchMs" in f:
        add("Warm launch to editable", "< 500 ms", f["launchMs"], f["launchMs"] < 500)
    if "keyToFrameP95" in f and document in ("typical", "rich"):
        add("Typing, key to frame p95", f"≤ 1 frame ({frame:.2f} ms)", f["keyToFrameP95"], f["keyToFrameP95"] <= frame)
    if document == "book" and "keyToFrameP95" in f:
        add("Typing, key to frame p95", f"≤ 2 frames ({2 * frame:.2f} ms)", f["keyToFrameP95"],
            f["keyToFrameP95"] <= 2 * frame)
        add("Typing, UI thread p95", "≤ 6 ms", f["typingUiP95"], f["typingUiP95"] <= 6)
    if "scrollP95" in f and "controlScrollP95" in f:
        over = f["scrollP95"] - f["controlScrollP95"]
        add("Scrolling p95 over the control", "≤ 1 ms", over, over <= 1)
    if document in ("typical", "rich") and "rewrapP95" in f and "controlRewrapP95" in f:
        over = f["rewrapP95"] - f["controlRewrapP95"]
        add("Re-wrap p95 over the control", "≤ 1 ms", over, over <= 1)
    if document == "book" and "rewrapSettleMs" in f:
        add("Re-wrap settle", "≤ 150 ms", f["rewrapSettleMs"], f["rewrapSettleMs"] <= 150)
        add("Layouts while the width moves", "0", f.get("layoutsWhileMoving", 0), f.get("layoutsWhileMoving", 0) == 0)
    if "idleFramesBesidesCaret" in f:
        add("Idle 60 s, frames besides the caret", "0", f["idleFramesBesidesCaret"], f["idleFramesBesidesCaret"] == 0)
    if "idleCpuTicks" in f:
        add("Idle 60 s, CPU ticks with helpers", "≤ 5", f["idleCpuTicks"], f["idleCpuTicks"] <= 5)
    # An ordinary session's memory: not what a megabyte pasted and undone leaves.
    if document == "typical" and not case["adversarial"] and "pssMiB" in f:
        add("Memory, PSS with owned processes", "< 150 MiB", f["pssMiB"], f["pssMiB"] < 150)
    return found


def number(value):
    if value is None:
        return "–"
    if isinstance(value, float) and not value.is_integer():
        return f"{value:.2f}"
    return str(int(value))


def markdown(summary):
    machine = summary["machine"]
    lines = ["# parch benchmark", ""]
    lines.append(f"{machine.get('architecture')}, {machine.get('cpus')} CPUs, Qt {machine.get('qt')}, "
                 f"{machine.get('platform')} platform, {machine.get('graphicsApi')} renderer, "
                 f"{number(machine.get('refreshHz'))} Hz, scale {number(machine.get('devicePixelRatio'))}; "
                 f"spelling {'on' if machine.get('spellingActive') else 'off (no dictionary)'}.")
    runs = summary.get("runs")
    if runs:
        lines.append(f"Started {runs['started']['time']} (load {runs['started']['load']}), ended "
                     f"{runs['ended']['time']} (load {runs['ended']['load']}).")
        if runs.get("offscreen"):
            lines.append("Offscreen, on the software renderer: no measure of the desktop.")
        if runs.get("failures"):
            lines.append(f"Failed runs: {', '.join(sorted(runs['failures']))}.")
    lines += ["", "Medians over each case's runs.", "", "## Gates", "",
              "| Case | Gate | Target | Measured | |", "| --- | --- | --- | ---: | --- |"]
    for name, case in summary["cases"].items():
        for gate, target, value, passes in gates(case):
            lines.append(f"| {name} | {gate} | {target} | {number(value)} | {'pass' if passes else '**missed**'} |")
    lines += ["", "## Other figures", "",
              "| Case | Runs | CPU ms per key: all (UI thread / others) | Parses per key "
              "| Dropped frames scrolling / typing | Idle wakeups / context switches | Recovery restore ms | PSS MiB |",
              "| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: |"]
    for name, case in summary["cases"].items():
        f = case["figures"]
        lines.append(f"| {name} | {case['runs']} | {number(f.get('typingCpuMsPerKey'))} "
                     f"({number(f.get('typingUiThreadCpuMsPerKey'))} / "
                     f"{number(f.get('typingOtherThreadsCpuMsPerKey'))}) | "
                     f"{number(f.get('typingParsesPerKey'))} | {number(f.get('droppedFramesScrolling'))} / "
                     f"{number(f.get('droppedFramesTyping'))} | {number(f.get('idleWakeups'))} / "
                     f"{number(f.get('idleContextSwitches'))} | "
                     f"{number(f.get('recoveryRestoreMs'))} | {number(f.get('pssMiB'))} |")
    adversarial = {name: case for name, case in summary["cases"].items() if case["adversarial"]}
    if adversarial:
        lines += ["", "## Adversarial edits, until every view caught up", "",
                  "| Case | 1 MB paste ms | Its undo ms | Nesting 200 deep ms | 200 rapid keys ms | Rapid key to frame p95 |",
                  "| --- | ---: | ---: | ---: | ---: | ---: |"]
        for name, case in adversarial.items():
            f = case["figures"]
            lines.append(f"| {name} | {number(f.get('pasteCaughtUpMs'))} | {number(f.get('undoCaughtUpMs'))} | "
                         f"{number(f.get('nestingCaughtUpMs'))} | {number(f.get('rapidCaughtUpMs'))} | "
                         f"{number(f.get('rapidKeyToFrameP95'))} |")
    return "\n".join(lines) + "\n"


def compare(baseline, summary):
    """Every gate figure more than 20 % worse than the baseline's."""
    worse = []
    for name, case in summary["cases"].items():
        before = baseline.get("cases", {}).get(name)
        if not before:
            continue
        for key, least in COMPARED.items():
            was, now = before["figures"].get(key), case["figures"].get(key)
            if was is None or now is None:
                continue
            if now > was * 1.2 and now - was > least:
                worse.append((name, key, was, now))
    return worse


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("outdir", type=Path)
    parser.add_argument("--summary", action="store_true", help="summarize the runs already in OUTDIR; run nothing")
    parser.add_argument("--compare", type=Path, metavar="BASELINE", help="flag gate figures 20 %% worse than these")
    parser.add_argument("--view", choices=("source", "split", "reading"), help="one view instead of the matrix")
    parser.add_argument("--windows", type=int, choices=(1, 2), default=1)
    parser.add_argument("--adversarial", action="store_true")
    parser.add_argument("--document", action="append", choices=DOCUMENTS,
                        help="with --view: a document to measure (typical, book and long-paragraph by default)")
    parser.add_argument("--runs", type=int, default=3)
    parser.add_argument("--offscreen", action="store_true", help="without a display, on the software renderer")
    arguments = parser.parse_args()

    out = arguments.outdir
    ran = None
    if arguments.summary:
        if not out.is_dir():
            parser.error(f"there are no runs in {out}")
        previous = out / "summary.json"
        if previous.exists():
            ran = json.loads(previous.read_text()).get("runs")
    else:
        out.mkdir(parents=True, exist_ok=True)
        out = out.resolve()
        if arguments.view:
            documents = arguments.document or ["long-paragraph", "book", "typical"]
            cases = [(document, arguments.view, arguments.windows, arguments.adversarial) for document in documents]
        else:
            cases = list(MATRIX)
        ran = run_matrix(out, cases, arguments.runs, arguments.offscreen)
    summary = summarize(out, ran)
    (out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
    report = markdown(summary)
    if arguments.compare:
        baseline = json.loads(arguments.compare.read_text())
        worse = compare(baseline, summary)
        report += f"\n## Against {arguments.compare.name}\n\n"
        if baseline.get("label"):
            report += f"Baseline: {baseline['label']}\n\n"
        if worse:
            report += "| Case | Figure | Baseline | Now |\n| --- | --- | ---: | ---: |\n"
            report += "".join(f"| {name} | {key} | {number(was)} | **{number(now)}** |\n" for name, key, was, now in worse)
        else:
            report += "No gate figure is 20 % worse.\n"
    (out / "summary.md").write_text(report)
    print(report)
    if arguments.compare and worse:
        sys.exit(3)
    if ran and ran.get("failures"):
        sys.exit(1)


if __name__ == "__main__":
    main()
