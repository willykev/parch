#!/bin/sh
set -eu

# Adapted from sprawl's bin/install (MIT). Builds and installs the Arch
# package with its dependencies. It holds parch, its helpers and licences,
# its launcher entry and icon, and the English guide in /usr/share/doc/parch.
ROOT="$(CDPATH= cd -P -- "$(dirname -- "$0")/.." && pwd -P)"
cd "$ROOT/pkgbuild"
exec makepkg -fsi "$@"
