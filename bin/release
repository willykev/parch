#!/usr/bin/env python3
"""Build checked release assets; add --publish to push the tag and publish on GitHub."""
import argparse
import gzip
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
APP = next(ROOT.glob("*.pro")).stem
TITLE = APP.capitalize()


def run(*args, cwd=ROOT, env=None, capture=False):
    result = subprocess.run(args, cwd=cwd, env=env, check=True, text=True,
                            stdout=subprocess.PIPE if capture else None)
    return result.stdout.strip() if capture else None


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def download_recipe(recipe, checksum):
    """Turns pkgbuild/PKGBUILD, which builds a checkout, into the standalone
    recipe that builds the versioned source archive."""
    edits = [
        ("source=()", f'source=("https://github.com/willykev/{APP}/releases/download/v$pkgver/{APP}-$pkgver.tar.gz")'),
        ("sha256sums=()", f"sha256sums=('{checksum}')"),
        ('cd "$startdir/.."', f'cd "$srcdir/{APP}-$pkgver"'),
        (f'"$startdir/{APP}.', f'"pkgbuild/{APP}.'),
        ("# This recipe builds a checkout. bin/release also produces a standalone\n"
         "# download recipe with a versioned source URL and SHA-256 checksum.",
         "# Build the versioned release source and verify its SHA-256 checksum."),
    ]
    for old, new in edits:
        # An edit that no longer matches would publish a recipe that still
        # expects a checkout around it.
        if old not in recipe:
            raise RuntimeError(f"pkgbuild/PKGBUILD no longer contains {old!r}; update bin/release to match")
        recipe = recipe.replace(old, new)
    if "startdir" in recipe:
        raise RuntimeError("The download recipe still uses $startdir from pkgbuild/PKGBUILD")
    return recipe


def prepare(version, tag, commit):
    output = ROOT / "dist" / tag
    output.mkdir(parents=True, exist_ok=True)
    manifest = output / "manifest.json"
    if manifest.exists():
        saved = json.loads(manifest.read_text())
        if saved.get("commit") == commit and saved.get("architecture") == os.uname().machine:
            files = saved.get("assets", {})
            if files and all(Path(name).name == name and (output / name).is_file()
                             and digest(output / name) == checksum for name, checksum in files.items()):
                print("Verified existing release assets:", output, flush=True)
                return output, [output / name for name in files]

    archive = output / f"{APP}-{version}.tar.gz"
    source = subprocess.check_output(["git", "archive", "--format=tar",
                                      f"--prefix={APP}-{version}/", tag], cwd=ROOT)
    archive.write_bytes(gzip.compress(source, mtime=0))
    recipe = (ROOT / "pkgbuild/PKGBUILD").read_text()
    if re.search(r"^pkgver=(.+)$", recipe, re.M).group(1).strip("'\"") != version:
        raise RuntimeError("VERSION and pkgbuild/PKGBUILD disagree")
    (output / "PKGBUILD").write_text(download_recipe(recipe, digest(archive)))

    # The package is built from the download recipe, with the source archive
    # as its source cache, so the published recipe is proven to build. The
    # build tree stays in dist/, which this user owns, rather than in /tmp.
    with tempfile.TemporaryDirectory(prefix=f"{APP}-release-", dir=output.parent) as scratch:
        shutil.copy(output / "PKGBUILD", scratch)
        env = dict(os.environ, BUILDDIR=scratch, SRCDEST=str(output), PKGDEST=str(output))
        run("makepkg", "--cleanbuild", "--force", "--nodeps", "--noconfirm", cwd=scratch, env=env)
        checkout = Path(scratch) / "src" / f"{APP}-{version}"
        reported = run(str(checkout / f"build/{APP}"), "--version", capture=True)
        if reported != f"{APP} {version}":
            raise RuntimeError(f"Unexpected binary version: {reported}")
        # Every test runs: the math and diagram helpers and the CSL suite's
        # fixtures are fetched, checked against their pinned checksums.
        run(str(checkout / "bin/fetch-helpers"), cwd=checkout, env=env)
        run(str(checkout / "bin/fetch-test-fixtures"), cwd=checkout, env=env)
        run(str(checkout / "bin/test"), cwd=checkout, env=env)
        package_list = run("makepkg", "--packagelist", cwd=scratch, env=env, capture=True)
        packages = [Path(name) for name in package_list.splitlines()]
        if not packages or not all(package.is_file() for package in packages):
            raise RuntimeError("makepkg did not produce the expected packages")
        # The package again under a name without its version, so that
        # releases/latest/download/<app>-<arch>.pkg.tar.zst always finds it.
        stable = output / f"{APP}-{os.uname().machine}{''.join(packages[0].suffixes[-3:])}"
        shutil.copyfile(packages[0], stable)
        packages.append(stable)

    assets = [archive, output / "PKGBUILD", *packages]
    checksums = output / "SHA256SUMS"
    checksums.write_text("".join(f"{digest(path)}  {path.name}\n" for path in assets))
    assets.append(checksums)
    manifest.write_text(json.dumps({"commit": commit, "architecture": os.uname().machine,
                                   "assets": {path.name: digest(path) for path in assets}}, indent=2) + "\n")
    return output, assets


def check_publish(tag):
    """Checks what publishing needs before the build, so that nothing is
    pushed when a later step is already known to fail: a pushed tag moves
    only by force, so a failure after the push strands it without a release."""
    remote = run("git", "remote", "get-url", "origin", capture=True)
    match = re.fullmatch(r"(?:https://github\.com/|git@github\.com:)([^/]+/[^/]+)", remote)
    if not match:
        raise RuntimeError("origin must be a GitHub repository")
    repo = match.group(1).removesuffix(".git")
    if repo != f"willykev/{APP}":
        raise RuntimeError(f"Review the release recipe and publishing target before publishing to {repo}")
    if not (ROOT / f"docs/releases/{tag}.md").is_file():
        raise RuntimeError(f"Write docs/releases/{tag}.md and tag the commit that adds it before publishing")
    run("gh", "auth", "status")
    headers = run("gh", "api", "--include", "user", capture=True)
    scopes = re.search(r"(?im)^x-oauth-scopes:[ \t]*([^\r\n]*)", headers)
    if scopes and "workflow" not in {scope.strip() for scope in scopes.group(1).split(",")}:
        print("GitHub needs the workflow permission to push the build checks.", flush=True)
        run("gh", "auth", "refresh", "--hostname", "github.com", "--scopes", "workflow")
    # Setting the description, topics, and default branch takes admin access.
    permission = run("gh", "repo", "view", repo, "--json", "viewerPermission",
                     "--jq", ".viewerPermission", capture=True)
    if permission != "ADMIN":
        raise RuntimeError(f"Publishing needs admin access to {repo}")
    # A dry run asks the remote whether it would take the push: the
    # credentials, a fast-forward of main, and no other commit under the tag.
    run("git", "push", "--dry-run", "--quiet", "--atomic", "origin", "HEAD:refs/heads/main", f"refs/tags/{tag}")
    return repo


def publish(version, tag, assets, repo):
    # Everything here that can fail is read and checked before the push.
    metadata = json.loads((ROOT / ".github/project.json").read_text())
    options = ["gh", "repo", "edit", repo, "--description", metadata["description"],
               "--default-branch", "main", "--enable-issues", "--enable-wiki=false"]
    for topic in metadata["topics"]:
        options.extend(["--add-topic", topic])
    found = subprocess.run(["gh", "release", "view", tag, "--repo", repo, "--json", "assets,isDraft"],
                           cwd=ROOT, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    release = json.loads(found.stdout) if found.returncode == 0 else None
    missing = []
    if release:
        # A retry uploads only the assets the release lacks. One it already
        # has must be this very file, or the release would mix two builds.
        uploaded = {asset["name"]: asset.get("digest") for asset in release["assets"]}
        for path in assets:
            if path.name not in uploaded:
                continue
            if not uploaded[path.name]:
                raise RuntimeError(f"GitHub reports no checksum for {path.name} in the {tag} release, so it "
                                   f"cannot be compared with {path}. Delete it from the release and retry.")
            if uploaded[path.name] != f"sha256:{digest(path)}":
                raise RuntimeError(f"The {tag} release already has a different {path.name}. Delete it from "
                                   f"the release, or restore the uploaded file in {path.parent}, and retry.")
        missing = [path for path in assets if path.name not in uploaded]

    # Main and the tag land together or not at all.
    run("git", "push", "--atomic", "origin", "HEAD:refs/heads/main", f"refs/tags/{tag}")
    run(*options)
    if release:
        if missing:
            run("gh", "release", "upload", tag, *(str(path) for path in missing), "--repo", repo)
        if release["isDraft"]:
            run("gh", "release", "edit", tag, "--repo", repo, "--draft=false", "--latest")
    else:
        run("gh", "release", "create", tag, *(str(asset) for asset in assets),
            "--repo", repo, "--verify-tag", "--latest", "--title", f"{TITLE} {version}",
            "--notes-file", str(ROOT / f"docs/releases/{tag}.md"))
    print(f"Published: https://github.com/{repo}/releases/tag/{tag}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--publish", action="store_true", help="Push main and the tag, then publish the GitHub release")
    args = parser.parse_args()
    version = (ROOT / "VERSION").read_text().strip()
    if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version):
        raise RuntimeError("VERSION must contain a version such as 0.1.0")
    if run("git", "status", "--porcelain", capture=True):
        raise RuntimeError("Commit your changes before building a release")
    tag = f"v{version}"
    commit = run("git", "rev-parse", "HEAD", capture=True)
    tagged = run("git", "rev-parse", f"{tag}^{{commit}}", capture=True)
    if commit != tagged:
        raise RuntimeError(f"Check out {tag} before building its release")
    if run("git", "cat-file", "-t", f"refs/tags/{tag}", capture=True) != "tag":
        raise RuntimeError(f"{tag} must be an annotated tag: git tag -a {tag}")
    repo = check_publish(tag) if args.publish else None
    output, assets = prepare(version, tag, commit)
    print(f"Release {tag} is ready in {output}", flush=True)
    if repo:
        publish(version, tag, assets, repo)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"release: {error}", file=sys.stderr)
        sys.exit(1)
