#!/usr/bin/env python3
"""Redraw the README's pictures into screenshots/.

Every picture is drawn by parch itself, off screen, from the write-up in
examples/weather-station. No window opens, nothing reaches the desktop, and
nothing of your own is read or shown: the documents and the settings come
from a scratch home that goes away afterwards, so neither your files nor
your choice of font or theme can appear, and the theme is Omarchy's as it
ships.

Run it after changing how parch looks, and before a release. A picture that
looks the same as the one already there is left alone, so only what changed
shows up in git. It needs ImageMagick, the helpers that draw formulas and
diagrams (bin/fetch-helpers), and Omarchy's themes for themes.png.

diagram.gif is drawn the same way, one picture for each line of the
write-up's flowchart, typed one after another, and joined into a loop.
"""
import json
import os
from pathlib import Path
import platform
import re
import shutil
import struct
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
APP = ROOT / "build/parch"
OUT = ROOT / "screenshots"
EXAMPLE = ROOT / "examples/weather-station"
DOCUMENT = "weather-station.md"
# The library folder the write-up is kept in, and the notes beside it that
# only fill the list.
LIBRARY = "Garden"
OTHER_NOTES = {
    "compost-log.md": "# Compost log\n",
    "seed-order.md": "# Seed order\n",
    "tomato-trial.md": "# Tomato trial\n",
}
# One light and one dark theme of those Omarchy comes with.
THEMES = ["catppuccin-latte", "gruvbox"]
# The window sizes, in the pixels of a screen at normal scale. Pictures are
# drawn at twice that, so they stay sharp where GitHub scales them down; the
# two in themes.png at a scale that makes each as wide as WHOLE.
WHOLE = "1280x800"
CLOSE = "960x600"
TILE = "960x576"
# The diagram pictures: wide enough for the preview to draw a diagram at its
# own size beside the text, and the loop tall enough for the whole flowchart.
CHART = "1120x700"
LOOP = "1120x800"
# How long the loop shows each line of the flowchart, in hundredths of a
# second: the empty diagram, the first line, the others, and the whole.
LOOP_HOLDS = (100, 120, 80, 300)


def pixels(picture):
    """A PNG's or a GIF's width and height."""
    with open(picture, "rb") as file:
        head = file.read(24)
    if head.startswith(b"GIF"):
        return struct.unpack("<HH", head[6:10])
    return struct.unpack(">II", head[16:24])


def line_of(text, start):
    """The number, from 1, of the first line that starts with `start`."""
    for number, line in enumerate(text.split("\n"), 1):
        if line.startswith(start):
            return number
    sys.exit(f"screenshots: the example has no line starting {start!r}")


class Stage:
    """A scratch home with the write-up in its library, and parch drawing there."""

    def __init__(self, scratch):
        self.scratch = Path(scratch)
        self.home = self.scratch / "home"
        self.library = self.home / LIBRARY
        self.env = {
            "PATH": os.environ["PATH"],
            "HOME": str(self.home),
            "LANG": "C.UTF-8",
            "TZ": "UTC",
            # Off screen, drawn by the processor, and out of reach of the
            # desktop: no window, no portal, the same picture on any machine.
            "QT_QPA_PLATFORM": "offscreen",
            "QT_QUICK_BACKEND": "software",
            "QT_QPA_PLATFORMTHEME": "generic",
            "DBUS_SESSION_BUS_ADDRESS": "unix:path=/nonexistent",
            "NO_AT_BRIDGE": "1",
            "PARCH_HELPERS": str(ROOT / "build/helpers" / platform.machine()),
        }
        for name in ("config", "data", "state", "cache", "runtime", "tmp"):
            (self.scratch / name).mkdir()
        (self.scratch / "runtime").chmod(0o700)
        self.env.update({
            "XDG_CONFIG_HOME": str(self.scratch / "config"),
            "XDG_DATA_HOME": str(self.scratch / "data"),
            "XDG_STATE_HOME": str(self.scratch / "state"),
            "XDG_CACHE_HOME": str(self.scratch / "cache"),
            "XDG_RUNTIME_DIR": str(self.scratch / "runtime"),
            "TMPDIR": str(self.scratch / "tmp"),
        })
        self.home.mkdir()
        # The settings a new window has, with the write-up's folder in the library.
        settings = self.scratch / "config/parch/settings.json"
        settings.parent.mkdir(parents=True)
        settings.write_text(json.dumps({"libraryFolders": [str(self.library)]}) + "\n")
        self.text = (EXAMPLE / DOCUMENT).read_text()
        # What this screen's scale is, so pictures come out the same on any.
        self.screen = 1
        probe = self.scratch / "probe.png"
        self.draw(probe, "200x150", scale=1)
        self.screen = pixels(probe)[0] / 200

    def draw(self, picture, size, *options, theme=None, scale=2, text=None):
        """One picture of the write-up, on a fresh copy of it, or of `text` in
        its place. It is `scale` times the window's size in pixels: twice,
        unless said."""
        shutil.rmtree(self.library, ignore_errors=True)
        shutil.copytree(EXAMPLE, self.library)
        if text is not None:
            (self.library / DOCUMENT).write_text(text)
        for name, text in OTHER_NOTES.items():
            (self.library / name).write_text(text)
        look = ["--theme", theme] if theme else ["--default-theme"]
        env = dict(self.env, QT_SCALE_FACTOR=f"{scale / self.screen:g}")
        subprocess.run([str(APP), "--screenshot", str(picture), "--size", size, *look, *map(str, options),
                        str(self.library / DOCUMENT)], env=env, check=True, cwd=self.scratch)


def themes(stage, picture):
    """The same view in a light and a dark theme, side by side."""
    tiles = []
    for theme in THEMES:
        tiles.append(stage.scratch / f"{theme}.png")
        stage.draw(tiles[-1], TILE, "--view", "split", "--no-library", "--line", line_of(stage.text, "$$"),
                   theme=theme, scale=int(WHOLE.split("x")[0]) / int(TILE.split("x")[0]))
    subprocess.run(["magick", "montage", *map(str, tiles), "-tile", "2x1", "-geometry", "+12+12",
                    "-background", "none", "-depth", "8", "-strip", str(picture)], check=True)


def typing(stage, picture):
    """The write-up's flowchart typed a line at a time beside its preview,
    which draws the diagram again after each line: a loop."""
    text = stage.text
    start = text.index("```mermaid\nflowchart") + len("```mermaid\n")
    end = text.index("```", start)
    lines = text[start:end].splitlines(keepends=True)
    heading = line_of(text, "## Where the readings go")
    frames = []
    for count in range(1, len(lines) + 1):
        typed = "".join(lines[:count])
        frames.append(stage.scratch / f"typing-{count}.png")
        # The caret at the end of the line just typed.
        caret = start + len(typed) - 1
        stage.draw(frames[-1], LOOP, "--view", "split", "--no-library", "--line", heading,
                   "--select", f"{caret},{caret}", text=text[:start] + typed + text[end:])
    first, second, each, last = LOOP_HOLDS
    holds = [first, second] + [each] * (len(frames) - 3) + [last]
    sequence = []
    for frame, hold in zip(frames, holds):
        sequence += ["-delay", str(hold), str(frame)]
    subprocess.run(["magick", "-loop", "0", *sequence, "+dither", "-layers", "Optimize", str(picture)], check=True)


def same_picture(kept, drawn):
    """Whether two pictures look the same, frame by frame for a loop."""
    def frames(picture):
        if picture.suffix != ".gif":
            return [picture]
        folder = Path(tempfile.mkdtemp(dir=drawn.parent))
        subprocess.run(["magick", str(picture), "-coalesce", str(folder / "%03d.png")], check=True)
        return sorted(folder.iterdir())
    old, new = frames(kept), frames(drawn)
    if len(old) != len(new):
        return False
    for a, b in zip(old, new):
        result = subprocess.run(["magick", "compare", "-metric", "AE", "-fuzz", "2%", str(a), str(b), "null:"],
                                capture_output=True, text=True)
        differing = re.search(r"\(([^)]+)\)", result.stderr)
        if result.returncode not in (0, 1) or not differing or float(differing.group(1)) != 0:
            return False
    return True


def settle(drawn, kept):
    """Put a newly drawn picture in place, unless the one already there looks
    the same. Says whether it changed."""
    if kept.exists() and same_picture(kept, drawn):
        return False
    shutil.move(drawn, kept)
    return True


def main():
    if not shutil.which("magick"):
        sys.exit("screenshots: magick (ImageMagick) is needed, and is not installed")
    helpers = ROOT / "build/helpers" / platform.machine()
    if not (helpers / "render-svg").exists() or not (helpers / "merman-cli").exists():
        sys.exit("screenshots: the formulas and diagrams need their helpers; run bin/fetch-helpers first")
    for theme in THEMES:
        if not (Path("/usr/share/omarchy/themes") / theme / "colors.toml").exists():
            sys.exit(f"screenshots: themes.png needs Omarchy's {theme} theme, which is not installed")
    subprocess.run([str(ROOT / "bin/build")], check=True, stdout=subprocess.DEVNULL)
    OUT.mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="parch-screenshots-") as scratch:
        stage = Stage(scratch)
        drawn = stage.scratch / "drawn"
        drawn.mkdir()
        text = stage.text
        # The whole window: the library, the text, and the preview beside it
        # from a heading, with the whole script coloured, the formula and
        # the table.
        stage.draw(drawn / "hero.png", WHOLE, "--view", "split", "--library",
                   "--line", line_of(text, "## Reading the sensor"))
        # The table of readings as a grid in the text, the caret in a cell so
        # that its row's and column's handles show.
        reading = text.index("| 10:00 |") + len("| 10:00 |   1")
        stage.draw(drawn / "tables.png", CLOSE, "--view", "source", "--no-library",
                   "--line", line_of(text, "## A Saturday"), "--select", f"{reading},{reading}")
        # The code blocks, coloured in the preview, beside their source.
        stage.draw(drawn / "code.png", CLOSE, "--view", "split", "--no-library",
                   "--line", line_of(text, "```sh"))
        # A cited paragraph, and the notes and bibliography that follow it.
        stage.draw(drawn / "citations.png", CLOSE, "--view", "reading", "--no-library",
                   "--line", line_of(text, "## About the dew point"))
        # A pie chart from a mermaid block, in the theme's colours, beside it.
        stage.draw(drawn / "pie-chart.png", CHART, "--view", "split", "--no-library",
                   "--line", line_of(text, "## What it cost"))
        # Export as PDF: what it leaves out, and its pages.
        stage.draw(drawn / "export.png", CLOSE, "--view", "split", "--no-library",
                   "--line", line_of(text, "## Reading the sensor"), "--show", "export")
        themes(stage, drawn / "themes.png")
        typing(stage, drawn / "diagram.gif")
        for picture in sorted(path for path in drawn.iterdir() if path.is_file()):
            kept = OUT / picture.name
            changed = settle(picture, kept)
            width, height = pixels(kept)
            size = kept.stat().st_size // 1024
            limit = 3000 if kept.suffix == ".gif" else 500
            print(f"{kept.relative_to(ROOT)}  {width}x{height}  {size} KB  {'redrawn' if changed else 'unchanged'}"
                  + (f"  (over {limit} KB)" if size > limit else ""))


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        sys.exit(f"screenshots: {error}")
